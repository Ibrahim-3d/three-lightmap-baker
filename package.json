{
  "name": "lightmap-baker",
  "version": "1.1.0",
  "description": "Browser-first Three.js lightmap baker with path-traced GI, automatic lightmap UVs, textured and multi-material transport, AO, denoising, and native LightProbeGrid support",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "license": "MIT",
  "author": "Ibrahim-3d",
  "homepage": "https://github.com/Ibrahim-3d/three-lightmap-baker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ibrahim-3d/three-lightmap-baker.git"
  },
  "bugs": {
    "url": "https://github.com/Ibrahim-3d/three-lightmap-baker/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "threejs",
    "three",
    "webgl",
    "webgl2",
    "lightmap",
    "lightmapping",
    "baked-lighting",
    "global-illumination",
    "path-tracing",
    "light-probes",
    "light-probe-grid",
    "spherical-harmonics",
    "bvh",
    "three-mesh-bvh",
    "xatlas",
    "r3f",
    "react-three-fiber",
    "3d",
    "rendering",
    "procedural-3d",
    "architectural-visualization",
    "configurator"
  ],
  "sideEffects": false,
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/package",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "docs/GETTING_STARTED.md",
    "docs/API_STATUS.md",
    "docs/LIGHT_PROBES.md"
  ],
  "scripts": {
    "build": "pnpm run build:package",
    "build:package": "node scripts/clean-package.mjs && vite build --config vite.lib.config.js && tsc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "lint": "eslint packages/",
    "format:check": "prettier --check packages/ examples/",
    "test": "playwright test --config playwright.correctness.config.ts",
    "test:correctness": "playwright test --config playwright.correctness.config.ts",
    "test:api-import": "node scripts/clean-package.mjs && vite build --config vite.lib.config.js && tsc -p tsconfig.lib.json && node tests/api-import-smoke.mjs",
    "release:check": "pnpm run typecheck && pnpm run typecheck:examples && pnpm run lint && pnpm run format:check && pnpm run test:correctness && pnpm run test:api-import && npm publish --dry-run --access public"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three-mesh-bvh": "^0.9.14",
    "xatlas-three": "^0.2.1"
  },
  "peerDependencies": {
    "three": ">=0.185.1 <0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.2.1",
    "lucide-preact": "^0.460.0",
    "postcss": "^8.4.0",
    "preact": "^10.24.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "three": "0.185.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "xatlasjs": "0.2.0"
  }
}
